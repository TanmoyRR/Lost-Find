# =============================================================================
# IUBAT SmartFind - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Django Core ---
SECRET_KEY=django-insecure-abc123def456-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://yourdomain.com

# --- Database (Supabase PostgreSQL) ---
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432

# --- Supabase Storage (S3-compatible) ---
SUPABASE_S3_ACCESS_KEY=your_s3_access_key
SUPABASE_S3_SECRET_KEY=your_s3_secret_key
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_BUCKET=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# --- SSLCommerz Payment Gateway ---
SSLCOMMERZ_STORE_ID=your_store_id_here
SSLCOMMERZ_STORE_PASS=your_store_password_here
SSLCOMMERZ_IS_SANDBOX=True

# --- Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@iubat-smartfind.com

# --- Celery (optional - remove if no Redis) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- AI (Jina Embeddings API - no local model, no GPU) ---
JINA_API_KEY=your_jina_api_key_here
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-nano
JINA_EMBEDDING_DIMENSIONS=256
JINA_TIMEOUT=30
JINA_MAX_RETRIES=2
JINA_RATE_LIMIT_DELAY=0.3

# --- AI Matching (hybrid scoring) ---
AI_MATCH_THRESHOLD=0.35
AI_MATCH_CANDIDATES=20
AI_MATCH_RESULTS=5
AI_SEARCH_RESULTS=20
AI_SEARCH_MIN_SCORE=0.25

# --- Site ---
SITE_NAME=IUBAT SmartFind
SITE_URL=https://yourdomain.com
